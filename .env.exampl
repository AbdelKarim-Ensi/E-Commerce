
NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth / JWT ---
# Generate strong, DISTINCT secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=changeme_generate_a_random_32plus_char_secret
JWT_REFRESH_SECRET=changeme_generate_a_different_random_32plus_char_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cookies ---
# Must be true in staging/production (HTTPS only)
COOKIE_SECURE=false

# --- CORS ---
CORS_ORIGIN=http://localhost:4200

# --- Frontend (used to build links embedded in transactional emails, e.g. password reset) ---
FRONTEND_URL=http://localhost:4200

# --- API (used to build backend-facing links embedded in emails, e.g. newsletter unsubscribe) ---
API_URL=http://localhost:3000

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme

# --- Supabase Storage ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=changeme_service_role_key

# --- Email (Brevo SMTP) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=changeme
SMTP_PASS=changeme
SMTP_FROM=no-reply@example.com

# --- Firebase Admin SDK (Google Sign-In backend verification) ---
FIREBASE_PROJECT_ID=changeme-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-changeme@changeme-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nchangeme\n-----END PRIVATE KEY-----\n"

# --- Seed / initial admin account (used by prisma/seed.ts) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme_strong_password"
# Comma-separated list of additional emails to promote to ADMIN on seed, if supported
ADMIN_EMAILS="admin@example.com"
