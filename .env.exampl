# Copy this file to .env and fill in real values.
# NEVER commit .env, .env.local, .env.production, etc. — see .gitignore.
# In staging/prod, prefer a secrets manager (Doppler, Vault, AWS Secrets Manager)
# over files on disk entirely — see note at the bottom.

NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth / JWT ---
# Generate strong, DISTINCT secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=changeme_generate_a_random_32plus_char_secret
JWT_REFRESH_SECRET=changeme_generate_a_different_random_32plus_char_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cookies ---
# Must be true in staging/production (HTTPS only)
COOKIE_SECURE=false

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Doppler (secrets manager) — recommended for staging/prod instead of .env files:
#   doppler setup                 # link this repo to a Doppler project/config
#   doppler run -- npm run start:prod   # injects secrets as env vars at runtime
# This avoids secrets ever touching disk or CI logs.
# ---------------------------------------------------------------------------
# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme

# --- Supabase Storage ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=changeme_service_role_or_anon_key
SUPABASE_BUCKET=product-images

# --- Email (Brevo SMTP) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=changeme
SMTP_PASSWORD=changeme